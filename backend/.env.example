# ── 数据库（docker compose 起的 postgres）──
DATABASE_URL=postgresql+psycopg://smartbot:smartbot_dev@127.0.0.1:5432/smart_support

# ── 平台默认模型（未配置 BYOM 的商户走这套；任意 OpenAI 兼容端点）──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ── token 签名 + 渠道凭据加密密钥（生产必填！生成：python -c "import secrets; print(secrets.token_hex(32))"）──
SECRET_KEY=

# ── 邮箱验证码 SMTP（生产必配；本地不配则走 MAIL_DEV_MODE 回退）──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 本地联调：true 时未配 SMTP 也可注册（验证码打日志+随响应返回）；生产必须 false！
MAIL_DEV_MODE=true

# ── RPA 渠道目标 ──
# simulator=内置模拟拼多多后台（演示/测试）；real=真实商家后台（需先联调 selectors.py）
CHANNEL_RPA_TARGET=simulator
CHANNEL_SIM_URL=http://127.0.0.1:8000/simulator/
