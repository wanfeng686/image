# ── 数据库（docker compose 起的 postgres）──
DATABASE_URL=postgresql+psycopg://smartbot:smartbot_dev@127.0.0.1:5432/smart_support

# ── 平台默认模型（未配置 BYOM 的商户走这套；任意 OpenAI 兼容端点）──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ── token 签名密钥（生产必填！生成：python -c "import secrets; print(secrets.token_hex(32))"）──
SECRET_KEY=
